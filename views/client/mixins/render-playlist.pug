mixin render-playlists(playlists)
  each item in playlists
    .col-3.mb-3
      .item
        .inner-image
          a(href=`/playlists/${item.slug}`)
            img(src=item.avatar alt=item.title)
        .inner-content
          a(href=`/playlists/${item.slug}`)
            h5(class="card-title") #{item.title}
          p(class="card-text") #{item.description} 