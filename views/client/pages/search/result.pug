extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .container.my-3
      .row
        .col-12
          +box-head(`Search results for “${keyword}”`)
      .row
        .col-9
          each item, index in listSongs
            li.d-flex.justify-content-between.align-items-center.border-bottom.px-3.py-2
              .d-flex.align-items-center.justify-content-start
                .d-flex.align-items-center
                  .me-3
                    .rounded-circle.bg-light(style=`height: 30px; width: 30px; background-image: url('${item.avatar}')`)
                  .me-2
                    button.btn.btn-outline-secondary.btn-sm(tabindex="0", title="Play") Play
                .me-auto
                  .d-flex.align-items-center
                    a.text-secondary.me-1(href=`/songs/detail/${item.slug}`) #{item.title}
              .d-flex.align-items-center.justify-content-end
                span.badge.bg-secondary.text-light.me-3 4,131
                .btn-group
                  button.btn.btn-sm.btn-outline-secondary(title="Like" aria-label="Like" )
                    i.fa.fa-heart 
                  button.btn.btn-sm.btn-outline-secondary(title="Repost" aria-label="Repost") Repost
                  button.btn.btn-sm.btn-outline-secondary(title="Share" aria-label="Share") Share
                  button.btn.btn-sm.btn-outline-secondary(title="Copy Link" aria-label="Copy Link") Copy Link
                  button.btn.btn-sm.btn-outline-secondary(title="More" aria-label="More") More
